<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>irai.Tests</RootNamespace>
        <AssemblyName>irai.Tests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ChiffadicErrors" Version="0.2.0" />
        <PackageReference Include="coverlet.collector" Version="10.1.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageReference Include="NUnit" Version="5.0.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1"/>
        <PackageReference Include="NSubstitute" Version="6.2.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0"/>
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <ProjectReference Include="../irai/irai.csproj"/>
    </ItemGroup>

</Project>
